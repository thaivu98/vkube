apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
localAPIEndpoint:
  advertiseAddress: "{{ .AdvertiseAddress }}"
  bindPort: 6443
nodeRegistration:
  name: "{{ .NodeName }}"
  criSocket: "unix:///run/containerd/containerd.sock"
  imagePullPolicy: {{ .ImagePullPolicy }}
{{- if .CertificateKey }}
certificateKey: "{{ .CertificateKey }}"
{{- end }}
---
apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
kubernetesVersion: "{{ .KubernetesVersion }}"
clusterName: "{{ .ClusterName }}"
{{- if .ControlPlaneEndpoint }}
controlPlaneEndpoint: "{{ .ControlPlaneEndpoint }}"
{{- end }}
imageRepository: "{{ .ImageRepository }}"
networking:
  podSubnet: "{{ .PodSubnet }}"
  serviceSubnet: "{{ .ServiceSubnet }}"
{{- if or .CertSANs .APIServerExtraArgs .EncryptSecrets }}
apiServer:
{{- if .CertSANs }}
  certSANs:
{{- range .CertSANs }}
    - "{{ . }}"
{{- end }}
{{- end }}
{{- if or .APIServerExtraArgs .EncryptSecrets }}
  extraArgs:
{{- if .EncryptSecrets }}
    - name: encryption-provider-config
      value: "/etc/kubernetes/enc/encryption-config.yaml"
{{- end }}
{{- range .APIServerExtraArgs }}
    - name: "{{ .Name }}"
      value: "{{ .Value }}"
{{- end }}
{{- end }}
{{- if or .EncryptSecrets .CISHardening }}
  extraVolumes:
{{- if .EncryptSecrets }}
    - name: vkube-enc
      hostPath: "/etc/kubernetes/enc"
      mountPath: "/etc/kubernetes/enc"
      readOnly: true
      pathType: DirectoryOrCreate
{{- end }}
{{- if .CISHardening }}
    - name: vkube-audit-policy
      hostPath: "/etc/kubernetes/audit"
      mountPath: "/etc/kubernetes/audit"
      readOnly: true
      pathType: DirectoryOrCreate
    - name: vkube-audit-log
      hostPath: "/var/log/kubernetes/audit"
      mountPath: "/var/log/kubernetes/audit"
      readOnly: false
      pathType: DirectoryOrCreate
{{- end }}
{{- end }}
{{- end }}
{{- if .ControllerManagerExtraArgs }}
controllerManager:
  extraArgs:
{{- range .ControllerManagerExtraArgs }}
    - name: "{{ .Name }}"
      value: "{{ .Value }}"
{{- end }}
{{- end }}
{{- if .SchedulerExtraArgs }}
scheduler:
  extraArgs:
{{- range .SchedulerExtraArgs }}
    - name: "{{ .Name }}"
      value: "{{ .Value }}"
{{- end }}
{{- end }}
---
apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration
cgroupDriver: systemd
{{- if .ServerTLSBootstrap }}
serverTLSBootstrap: true
{{- end }}
{{- if .CISHardening }}
readOnlyPort: 0
streamingConnectionIdleTimeout: "5m0s"
{{- end }}
